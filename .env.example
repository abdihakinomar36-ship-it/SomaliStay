# SomaliStay environment — copy to .env.local and fill in
# Values for the dedicated SomaliStay Supabase project (do NOT use another project's keys)

# Supabase project URL (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable/anon key (Settings → API). Safe for the browser — RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL (used for auth redirect links), e.g. https://somalistay.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
